<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notch_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_crimson_notch"
    android:padding="12dp">

    <!-- Header Alert Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notch_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚠️ CRITICAL RISK: DO NOT ENTER PIN"
            android:textColor="#FF4D4D"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notch_risk_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_risk_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="RISK: 95%"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Receiver VPA Details -->
    <TextView
        android:id="@+id/notch_vpa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Receiver: pmcares.refund@okaxis"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Trigger Reason Description -->
    <TextView
        android:id="@+id/notch_reason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Reason: Blacklisted Fraud ID • Active Call Detected"
        android:textColor="#FFCCCC"
        android:textSize="12sp" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btn_dismiss_notch"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/btn_dismiss_bg"
            android:text="DISMISS"
            android:textColor="#CCCCCC"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp" />

        <Button
            android:id="@+id/btn_abort_payment"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_abort_bg"
            android:text="ABORT PAYMENT"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="14dp" />
    </LinearLayout>

</LinearLayout>

